model Service {
    id          String  @id @default(uuid())
    title       String
    description String?
    price       Decimal @db.Decimal(10, 2)

    technicialId String
    technician TechnicianProfile @relation(fields: [technicialId], references: [id], onDelete: Cascade)

    categoryId String
    category Category @relation(fields: [categoryId], references: [id])

    booking Booking[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("services")
}
